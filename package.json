{
  "name": "jts-website",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm build:search && astro dev",
    "start": "astro dev",
    "cv:build:public": "tsx scripts/generate-cv.ts --public",
    "build:cv": "pnpm cv:build:public",
    "cv:build": "tsx scripts/generate-cv.ts",
    "cv:build:all": "tsx scripts/generate-cv.ts --all-private",
    "cv:check:poppler": "tsx scripts/check-cv-poppler.ts public/assets/cv/jonathan-cv.pdf",
    "cv:check:dist": "tsx scripts/check-cv-dist.ts dist",
    "build:search": "tsx scripts/build-search-index.ts",
    "build": "pnpm build:cv && pnpm build:search && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:update-missing": "playwright test --update-snapshots=missing",
    "test:e2e:webkit": "PLAYWRIGHT_WEBKIT=1 playwright test --project=webkit-mobile",
    "test:e2e:install": "playwright install --with-deps chromium webkit",
    "test": "vitest run --exclude tests/integration/cv-generation.test.ts",
    "coverage": "vitest run --exclude tests/integration/cv-generation.test.ts --coverage --coverage.provider=v8 --coverage.reporter=lcov",
    "test:all": "pnpm test:unit && pnpm test:e2e",
    "lint": "eslint .",
    "deadcode": "knip",
    "lint:content": "tsx scripts/validate-content.ts",
    "sync:content": "tsx scripts/sync-content.ts",
    "refresh:engineering": "tsx scripts/refresh-engineering-snapshot.ts",
    "check": "astro check",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "astro": "^7.4.13",
    "gray-matter": "^4.0.3",
    "html2canvas": "^1.4.1",
    "katex": "^0.19.1",
    "mermaid": "^12.3.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/fs-extra": "^11.0.4",
    "@types/mdast": "^4.0.4",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "fast-check": "4.11.0",
    "fs-extra": "^11.4.1",
    "globals": "^17.14.0",
    "knip": "^6.47.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-html": "^16.0.1",
    "remark-parse": "^11.0.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.73.0",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vitest": "5.1.1"
  },
  "pnpm": {
    "overrides": {
      "fflate@>=0.7.0 <0.7.5": "0.7.5",
      "katex": "$katex"
    }
  }
}
