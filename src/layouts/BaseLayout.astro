---
import { themeInlineScript } from '../lib/theme/theme-inline-script';
import SeoHead from '../components/site/SeoHead.astro';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import SearchDialog from '../components/search/SearchDialog.astro';
import Toast from '../components/site/Toast.astro';
import ConsentBanner from '../components/site/ConsentBanner.astro';
import AnalyticsScripts from '../components/site/AnalyticsScripts.astro';
import '../styles/tokens.css';
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { contentLocalePath, type Locale } from '../lib/content/locale';
import { useTranslations } from '../i18n/ui';
import { type PageType } from '../lib/seo/metadata';
import StructuredData from '../components/site/StructuredData.astro';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  image?: string | undefined;
  ogType?: 'website' | 'article' | undefined;
  locale?: Locale;
  translations?: Partial<Record<Locale, string>> | undefined;
  structuredData?: object | object[] | undefined;
  pageType?: PageType | undefined;
  noindex?: boolean | undefined;
}

const { title, description, image, ogType, locale = 'en', translations, structuredData, pageType, noindex } = Astro.props;
const t = useTranslations(locale);
---

<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline set:html={themeInlineScript} />
    {/* Static pages also pass `translations` (for the language switcher) as bare path
        maps; only articles feed them into hreflang, static pages keep path mapping. */}
    <SeoHead
      title={title}
      description={description}
      image={image}
      ogType={ogType}
      locale={locale}
      currentPath={Astro.url.pathname}
      pageType={pageType}
      translations={ogType === 'article' ? translations : undefined}
      noindex={noindex}
    />
    <link rel="alternate" type="application/rss+xml" title={t.feeds.blogTitle} href={contentLocalePath(locale, '/rss.xml')} />
    <link rel="alternate" type="application/rss+xml" title={t.feeds.notesTitle} href={contentLocalePath(locale, '/notes/rss.xml')} />
    <slot name="head" />
    {structuredData && (Array.isArray(structuredData) ? structuredData : [structuredData]).map(d => (
      <StructuredData data={d} />
    ))}
  </head>
  <body class="site-wrapper">
    <a href="#main-content" class="skip-link">{t.site.skipToContent}</a>
    <Header locale={locale} translations={translations} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={locale} currentPath={Astro.url.pathname} translations={translations} />
    <SearchDialog locale={locale} />
    <Toast locale={locale} />
    <ConsentBanner locale={locale} />
    <AnalyticsScripts />
  </body>
</html>

<style is:global>
  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }
  main {
    flex: 1;
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-6);
    padding-block: var(--space-12);
  }
  @media (min-width: 48rem) {
    main { padding-inline: var(--space-8); }
  }
</style>
