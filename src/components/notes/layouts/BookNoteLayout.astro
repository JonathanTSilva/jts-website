---
import TranslationFallbackNotice from '../../site/TranslationFallbackNotice.astro';
import { format, useTranslations } from '../../../i18n/ui';
import { formatDate } from '../../../lib/format';
import { resolveCover } from '../../../lib/content/cover';
import NoteLayoutWrapper, { type NoteLayoutProps } from './NoteLayoutWrapper.astro';

type Props = NoteLayoutProps;

const { note, Content, locale, prev, next, relatedNotes } = Astro.props;

const t = useTranslations(locale);

const isTranslationFallback = note.data.language !== locale;
const statusKey = note.data.status?.[0] as 'finished' | 'reading' | 'abandoned' | undefined;
const statusLabel = statusKey ? t.notes.bookStatus[statusKey] ?? statusKey : undefined;
// null when the remote cover cannot be fetched: a placeholder box is shown instead.
const cover = note.data.cover ? await resolveCover(note.data.cover) : null;
const dateStr = note.data.dateRead
  ? formatDate(note.data.dateRead, locale, { dateStyle: 'medium' })
  : undefined;
---

<NoteLayoutWrapper
  note={note}
  Content={Content}
  locale={locale}
  prev={prev}
  next={next}
  relatedNotes={relatedNotes}
  articleClass="book-note-page"
>
  <div class="book-header">
    {cover && (
      <img
        src={cover.src}
        width={cover.width}
        height={cover.height}
        alt={format(t.notes.bookCoverAlt, { title: note.data.title })}
        class="book-cover"
        loading="lazy"
        decoding="async"
      />
    )}
    {note.data.cover && !cover && <div class="book-cover book-cover-placeholder" aria-hidden="true"></div>}
    <div class="book-meta">
      {note.data.category && <span class="note-category-badge">{note.data.category}</span>}
      <h1 class="book-title">{note.data.title}</h1>
      {note.data.author && note.data.author.length > 0 && (
        <p class="book-author">{format(t.notes.bookBy, { authors: note.data.author.join(', ') })}</p>
      )}
      <div class="book-details">
        {note.data.rating && <span class="book-rating">{note.data.rating}</span>}
        {note.data.pages && <span class="book-pages">{format(t.notes.bookPages, { count: note.data.pages })}</span>}
        {statusLabel && <span class="book-status" data-status={statusKey}>{statusLabel}</span>}
        {dateStr && <span class="book-date-read">{format(t.notes.bookReadOn, { date: dateStr })}</span>}
      </div>
      {note.data.tags && note.data.tags.length > 0 && (
        <div class="note-tags">
          {note.data.tags.map((tag: string) => <span class="tag-pill">#{tag}</span>)}
        </div>
      )}
    </div>
  </div>

  <hr class="preamble-divider" />

  {isTranslationFallback && (
    <TranslationFallbackNotice message={t.notes.fallbackNotice} />
  )}

  <div class="note-content prose">
    <Content />
  </div>
</NoteLayoutWrapper>

<style>
  .book-note-page {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-10) var(--space-6);
  }

  .book-header {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-8);
    align-items: start;
    margin-bottom: var(--space-6);
  }

  @media (max-width: 40rem) {
    .book-header { grid-template-columns: 1fr; }
    .book-cover { max-width: 10rem; }
  }

  .book-cover {
    width: 8rem;
    height: auto;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    object-fit: cover;
  }

  .book-cover-placeholder {
    aspect-ratio: 2 / 3;
    background: var(--surface-high);
    border: 1px solid var(--border);
  }

  .note-category-badge {
    display: inline-block;
    background: color-mix(in srgb, var(--note-accent) 12%, var(--surface));
    color: var(--note-accent);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-3);
  }

  .book-title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    margin-bottom: var(--space-2);
    line-height: 1.3;
  }

  .book-author {
    font-size: var(--text-base);
    color: var(--text-muted);
    margin-bottom: var(--space-3);
  }

  .book-details {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .book-rating { color: var(--note-accent); letter-spacing: 0.05em; }

  .book-status {
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
  }
  .book-status[data-status="finished"] { background: color-mix(in srgb, #22c55e 15%, var(--surface)); color: #22c55e; }
  .book-status[data-status="reading"]  { background: color-mix(in srgb, #f59e0b 15%, var(--surface)); color: #f59e0b; }
  .book-status[data-status="abandoned"]{ background: color-mix(in srgb, #ef4444 15%, var(--surface)); color: #ef4444; }

  .note-tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .tag-pill {
    display: inline-block;
    background: var(--surface-high);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .preamble-divider {
    border: none;
    border-top: 1px solid var(--note-accent);
    margin: var(--space-6) 0;
    opacity: 0.5;
  }

  .note-content { margin-bottom: var(--space-10); }
  .note-content.prose { line-height: 1.6; }
  .note-content.prose :global(h2) { font-size: var(--text-2xl); margin-top: var(--space-8); margin-bottom: var(--space-4); }
  .note-content.prose :global(p) { margin-bottom: var(--space-4); }
  .note-content.prose :global(ul) { margin-bottom: var(--space-4); padding-left: var(--space-6); }
</style>
