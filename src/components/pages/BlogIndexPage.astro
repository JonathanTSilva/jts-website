---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogList from '../blog/BlogList.astro';
import { contentLocalePath, type Locale } from '../../lib/content/locale';
import { useTranslations } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const translations = {
  en: contentLocalePath('en', '/blog'),
  'pt-br': contentLocalePath('pt-br', '/blog'),
};
---

<BaseLayout locale={locale} pageType="blog-index" translations={translations}>
  <div class="container">
    <header class="page-header">
      <h1 class="page-title">{t.blog.title}</h1>
      <p class="page-description">{t.blog.description}</p>
    </header>

    <BlogList locale={locale} />
  </div>
</BaseLayout>

<style>
  .container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: var(--space-8) 0;
  }
  .page-header {
    margin-bottom: var(--space-12);
  }
  .page-title {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
  }
  .page-description {
    font-size: var(--text-lg);
    color: var(--text-muted);
  }
</style>
