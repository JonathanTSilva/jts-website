---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { contentPath, ogImagePath } from '../../lib/content/routes';
import type { Locale } from '../../lib/content/locale';
import { absoluteUrl } from '../../lib/site';
import { generateArticleSchema } from '../../lib/seo/schema';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DefaultNoteLayout from '../notes/layouts/DefaultNoteLayout.astro';
import BookNoteLayout from '../notes/layouts/BookNoteLayout.astro';
import MindmapLayout from '../notes/layouts/MindmapLayout.astro';
import WhiteboardLayout from '../notes/layouts/WhiteboardLayout.astro';

interface Props {
  locale: Locale;
  note: CollectionEntry<'notes'>;
  translations: Partial<Record<Locale, string>>;
  isTranslationFallback: boolean;
  prev: CollectionEntry<'notes'> | undefined;
  next: CollectionEntry<'notes'> | undefined;
  relatedNotes: CollectionEntry<'notes'>[];
  /** E2E fixture: served under /test-fixtures/, always noindex, no OG image generated. */
  isFixture?: boolean;
}

const { locale, note, translations, isTranslationFallback, prev, next, relatedNotes, isFixture = false } = Astro.props;
const { Content } = await render(note);

const layouts = {
  note:       DefaultNoteLayout,
  book:       BookNoteLayout,
  mindmap:    MindmapLayout,
  whiteboard: WhiteboardLayout,
} as const;

const NoteLayout = layouts[note.data.noteType ?? 'note'];
// Fixtures have no generated OG image: the layout falls back to the site-wide one.
const ogImage = isFixture ? undefined : ogImagePath('notes', note.data.language, note.data.slug);
const notePath = contentPath(isFixture ? 'test-fixtures/notes' : 'notes', locale, note.data.slug);
const { publishedAt, updatedAt } = note.data;
---

<BaseLayout
  locale={locale}
  title={note.data.title}
  description={note.data.summary ?? undefined}
  image={ogImage}
  ogType="article"
  translations={translations}
  noindex={isTranslationFallback || isFixture}
  structuredData={generateArticleSchema({
    title: note.data.title,
    description: note.data.summary ?? note.data.title,
    url: absoluteUrl(notePath),
    publishedAt,
    ...(updatedAt && { updatedAt }),
    ...(ogImage && { image: absoluteUrl(ogImage) }),
    locale,
  })}
>
  {/* Neighbour and related links are built as /notes/<slug>/, which fixtures do not have. */}
  <NoteLayout
    note={note}
    Content={Content}
    locale={locale}
    prev={isFixture ? undefined : prev}
    next={isFixture ? undefined : next}
    relatedNotes={isFixture ? [] : relatedNotes}
  />
</BaseLayout>
