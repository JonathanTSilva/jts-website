---
import {
  getDashboard,
  listedRepos,
  archivedPublicCount,
  repoBadges,
  HANDBOOK_URL,
  DASHBOARD_URL,
} from '../../lib/engineering/dashboard';
import type { Locale } from '../../lib/content/locale';
import { format, useTranslations } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { data } = await getDashboard();
const repos = listedRepos(data);
const archived = archivedPublicCount(data);
const generated = data.generated_at ? new Date(data.generated_at) : null;

const t = useTranslations(locale);

const statusLabels: Record<string, string> = t.engineering.statuses;
const archivedNote = format(
  archived === 1 ? t.engineering.archivedNote.one : t.engineering.archivedNote.other,
  { count: archived },
);

const dateText = generated
  ? generated.toLocaleDateString(locale, { dateStyle: 'long', timeZone: 'UTC' })
  : '';
---

<div class="container">
  <header class="eng-header">
    <h1 class="eng-title">{t.engineering.title}</h1>
    <p class="eng-intro">
      {t.engineering.intro}
      <a href={HANDBOOK_URL} rel="noopener noreferrer" target="_blank">{t.engineering.handbook}</a>.
    </p>
    {generated && (
      <p class="eng-updated">
        {t.engineering.dataFrom} <time datetime={generated.toISOString()}>{dateText}</time>
        (<a href={DASHBOARD_URL} rel="noopener noreferrer" target="_blank">{t.engineering.sourceLink}</a>)
      </p>
    )}
  </header>

  <section aria-label={t.engineering.summaryLabel}>
    <ul class="tiles">
      <li class="tile">
        <span class="tile-value">{data.summary.percent}%</span>
        <span class="tile-label">{t.engineering.reposOnStandard}</span>
        <span class="tile-detail">{data.summary.compliant} {t.engineering.of} {data.summary.total}</span>
      </li>
      <li class="tile">
        <span class="tile-value">{data.summary.ci_green}/{data.summary.ci_total}</span>
        <span class="tile-label">{t.engineering.ciGreen}</span>
        <span class="tile-detail">main</span>
      </li>
    </ul>
  </section>

  <div class="table-scroll" role="region" aria-label={t.engineering.scrollLabel} tabindex="0">
    <table class="eng-table">
      <caption class="visually-hidden">{t.engineering.tableCaption}</caption>
      <thead>
        <tr>
          <th scope="col">{t.engineering.columns.repo}</th>
          <th scope="col">{t.engineering.columns.status}</th>
          <th scope="col">{t.engineering.columns.ci}</th>
          <th scope="col">{t.engineering.columns.coverage}</th>
          <th scope="col">{t.engineering.columns.quality}</th>
          <th scope="col">{t.engineering.columns.scorecard}</th>
          <th scope="col">{t.engineering.columns.release}</th>
        </tr>
      </thead>
      <tbody>
        {repos.map((repo) => {
          const b = repoBadges(repo.name);
          const hasCi = repo.ci !== null;
          return (
            <tr>
              <th scope="row" class="repo-name">
                <a href={b.repo} rel="noopener noreferrer" target="_blank">{repo.name}</a>
              </th>
              <td>
                <span class="chip">{statusLabels[repo.status] ?? repo.status}</span>
              </td>
              <td>
                {hasCi ? (
                  <span class:list={['chip', repo.ci === 'success' ? 'chip-ok' : 'chip-warn']}>
                    {repo.ci === 'success' ? t.engineering.passing : t.engineering.notPassing}
                  </span>
                ) : (
                  <span class="na">{t.engineering.noCi}</span>
                )}
              </td>
              <td>
                {hasCi ? (
                  <a href={b.coverage} rel="noopener noreferrer" target="_blank">
                    <img src={b.coverageImg} alt={`${t.engineering.badgeAlt.coverage} ${repo.name}`} height="20" loading="lazy" decoding="async" />
                  </a>
                ) : (
                  <span class="na" aria-label={t.engineering.notApplicable}>&mdash;</span>
                )}
              </td>
              <td>
                {hasCi ? (
                  <a href={b.quality} rel="noopener noreferrer" target="_blank">
                    <img src={b.qualityImg} alt={`${t.engineering.badgeAlt.quality} ${repo.name}`} height="20" loading="lazy" decoding="async" />
                  </a>
                ) : (
                  <span class="na" aria-label={t.engineering.notApplicable}>&mdash;</span>
                )}
              </td>
              <td>
                {hasCi ? (
                  <a href={b.scorecard} rel="noopener noreferrer" target="_blank">
                    <img src={b.scorecardImg} alt={`${t.engineering.badgeAlt.scorecard} ${repo.name}`} height="20" loading="lazy" decoding="async" />
                  </a>
                ) : (
                  <span class="na" aria-label={t.engineering.notApplicable}>&mdash;</span>
                )}
              </td>
              <td>
                <a href={b.release} rel="noopener noreferrer" target="_blank">
                  <img src={b.releaseImg} alt={`${t.engineering.badgeAlt.release} ${repo.name}`} height="20" loading="lazy" decoding="async" />
                </a>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
  {archived > 0 && <p class="eng-note">{archivedNote}</p>}
</div>

<style>
  .container {
    max-width: var(--wide-max);
    margin: 0 auto;
    padding: var(--space-8) 0;
  }
  .eng-header {
    max-width: var(--container-max);
    margin-bottom: var(--space-8);
  }
  .eng-title {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
  }
  .eng-intro {
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-4);
  }
  .eng-updated,
  .eng-note {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text);
  }
  .eng-note {
    margin-top: var(--space-4);
  }

  .tiles {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-8);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-4);
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--card-padding);
    box-shadow: var(--shadow-sm);
  }
  .tile-value {
    font-size: var(--text-4xl);
    font-weight: var(--weight-bold);
    color: var(--accent);
    line-height: var(--leading-tight);
  }
  .tile-label {
    font-weight: var(--weight-semibold);
    color: var(--text);
  }
  .tile-detail {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text);
  }

  .table-scroll {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .table-scroll:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .eng-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  .eng-table th,
  .eng-table td {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    vertical-align: middle;
    white-space: nowrap;
    border-bottom: 1px solid var(--border);
  }
  .eng-table thead th {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--text);
    background: var(--surface-high);
  }
  .eng-table tbody tr:last-child th,
  .eng-table tbody tr:last-child td {
    border-bottom: none;
  }
  .repo-name {
    font-family: var(--font-mono);
    font-weight: var(--weight-medium);
  }
  .eng-table img {
    display: block;
    height: 20px;
    width: auto;
  }
  .eng-table a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .chip {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    padding: 2px var(--space-3);
    border-radius: var(--radius-full);
    background: var(--surface-high);
    color: var(--text);
    border: 1px solid var(--border);
  }
  .chip-ok {
    background: var(--accent-dim);
    color: var(--text);
    border-color: var(--text);
  }
  .chip-warn {
    background: var(--surface-high);
    color: var(--text);
    border-color: var(--text);
  }
  .na {
    color: var(--text);
  }
</style>
